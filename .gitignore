.DS_Store
*.swp
*.swo
*~

# Only configuration belongs in Git; history, sockets, locks and app backups stay local.
/mpv/*
!/mpv/mpv.conf
/openlogi/*
!/openlogi/config.toml

# Keep browser permissions, sessions and generated files out of version control.
/qutebrowser/*
!/qutebrowser/config.py

# Track yt-dlp configuration only; keep cookies and download state local.
/yt-dlp/*
!/yt-dlp/config
