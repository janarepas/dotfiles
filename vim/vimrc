" Use Vim defaults instead of Vi compatibility
set nocompatible

" Set leader keys before defining mappings
let mapleader = " "
let maplocalleader = " "

" Enable filetype detection, plugins and indentation
filetype plugin indent on

" Enable UTF-8 and syntax highlighting
set encoding=utf-8
syntax enable

" Appearance
" Load bundled colors from the real vimrc location, including through ~/.vimrc.
let &runtimepath = fnamemodify(resolve(expand('<sfile>:p')), ':h') . ',' . &runtimepath
if has('termguicolors')
  set termguicolors
endif
set background=dark
colorscheme tokyonight-night

" Match Neovim's transparent TokyoNight background.
highlight Normal guibg=NONE ctermbg=NONE
highlight NormalNC guibg=NONE ctermbg=NONE
highlight SignColumn guibg=NONE ctermbg=NONE
highlight NormalSB guibg=NONE ctermbg=NONE
highlight SignColumnSB guibg=NONE ctermbg=NONE
highlight NormalFloat guibg=NONE ctermbg=NONE
highlight FloatBorder guibg=NONE ctermbg=NONE

set number
set relativenumber
set cursorline
set nowrap
set scrolloff=8
set sidescrolloff=8
set wildmenu
set showcmd

" Indentation: two spaces
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set autoindent
set smartindent

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Editing
set backspace=indent,eol,start
set hidden

" Recovery and backups
set nobackup
set swapfile

" Keep recovery files private and out of project directories.
let s:swap_dir = expand("~/.vim/swap")
if !isdirectory(s:swap_dir)
  call mkdir(s:swap_dir, "p", 0700)
endif
" The full source path distinguishes files with the same name.
let &directory = escape(s:swap_dir, ' ,') . '//'

" Preserve undo history across sessions
if has("persistent_undo")
  let s:undo_dir = expand("~/.vim/undo")

  if !isdirectory(s:undo_dir)
    call mkdir(s:undo_dir, "p", 0700)
  endif

  let &undodir = s:undo_dir
  set undofile
endif

" Save the current buffer
nnoremap <silent> <Leader>w :write<CR>

" Close the current window
nnoremap <silent> <Leader>q :quit<CR>

" Open the built-in file explorer
nnoremap <silent> <Leader>e :Explore<CR>

" Clear search highlighting
nnoremap <silent> <Leader>h :nohlsearch<CR>

" Leave insert mode
inoremap jk <Esc>
inoremap jj <Esc>

" Protect credential files before reading undo, and on rename/write.
let s:sensitive_patterns = ['*/.env', '*/.env.*', '*.pem', '*.key', '*.p12', '*.pfx', '*/id_rsa', '*/id_ecdsa', '*/id_ed25519', '*/id_dsa', '*/.ssh/*', '*/.gnupg/*', '*/.netrc', '*/.authinfo', '*/.authinfo.gpg', '*/.aws/credentials', '*/.kube/config', '*/.docker/config.json', '*/.npmrc', '*/.pypirc', '*/.git-credentials']
let &backupskip .= ',' . join(s:sensitive_patterns, ',')

function! s:ProtectSensitiveBuffer() abort
  let l:name = expand('%:p')
  let l:resolved = resolve(l:name)
  let l:private = exists("b:dotfiles_private_name")
  for l:pattern in s:sensitive_patterns
    let l:regex = glob2regpat(l:pattern)
    if l:name =~# l:regex || l:resolved =~# l:regex
      let l:private = 1
      break
    endif
  endfor
  if l:private
    if get(b:, 'dotfiles_private_name', '') !=# l:name
    let &backupskip .= ',' . escape(escape(l:name, '*?[\]'), ',')
      let b:dotfiles_private_name = l:name
    endif
    setlocal noswapfile nomodeline
    if has('persistent_undo')
      setlocal noundofile
    endif
  endif
endfunction

augroup DotfilesPrivacy
  autocmd!
  autocmd BufReadPre,BufNewFile,BufFilePost,BufWritePre * call <SID>ProtectSensitiveBuffer()
augroup END
