" Use Vim defaults instead of Vi compatibility
set nocompatible

" Set leader keys before defining mappings
let mapleader = " "
let maplocalleader = " "

" Enable filetype detection, plugins and indentation
filetype plugin indent on

" Enable UTF-8 and syntax highlighting
set encoding=utf-8
syntax enable

" Appearance
set number
set relativenumber
set cursorline
set nowrap
set scrolloff=8
set sidescrolloff=8
set wildmenu
set showcmd

" Indentation: two spaces
set expandtab
set tabstop=2
set shiftwidth=2
set softtabstop=2
set autoindent
set smartindent

" Search
set hlsearch
set incsearch
set ignorecase
set smartcase

" Editing
set backspace=indent,eol,start
set hidden

" Recovery and backups
set nobackup
set swapfile

" Preserve undo history across sessions
if has("persistent_undo")
  let s:undo_dir = expand("~/.vim/undo")

  if !isdirectory(s:undo_dir)
    call mkdir(s:undo_dir, "p", 0700)
  endif

  let &undodir = s:undo_dir
  set undofile
endif

" Save the current buffer
nnoremap <silent> <Leader>w :write<CR>

" Close the current window
nnoremap <silent> <Leader>q :quit<CR>

" Open the built-in file explorer
nnoremap <silent> <Leader>e :Explore<CR>

" Clear search highlighting
nnoremap <silent> <Leader>h :nohlsearch<CR>

" Leave insert mode
inoremap jk <Esc>
inoremap jj <Esc>

" Protect credential files before reading undo, and on rename/write.
let s:sensitive_patterns = ['*/.env', '*/.env.*', '*.pem', '*.key', '*.p12', '*.pfx', '*/id_rsa', '*/id_ecdsa', '*/id_ed25519', '*/id_dsa', '*/.ssh/*', '*/.gnupg/*', '*/.netrc', '*/.authinfo', '*/.authinfo.gpg', '*/.aws/credentials', '*/.kube/config', '*/.docker/config.json', '*/.npmrc', '*/.pypirc', '*/.git-credentials']
let &backupskip .= ',' . join(s:sensitive_patterns, ',')

function! s:ProtectSensitiveBuffer() abort
  let l:name = expand('%:p')
  let l:resolved = resolve(l:name)
  for l:pattern in s:sensitive_patterns
    let l:regex = glob2regpat(l:pattern)
    if l:name =~# l:regex || l:resolved =~# l:regex
      if get(b:, 'dotfiles_private_name', '') !=# l:name
        let &backupskip .= ',' . escape(escape(l:name, '*?[\]'), ',')
        let b:dotfiles_private_name = l:name
      endif
      setlocal noswapfile nomodeline
      if has('persistent_undo')
        setlocal noundofile
      endif
      return
    endif
  endfor
endfunction

augroup DotfilesPrivacy
  autocmd!
  autocmd BufReadPre,BufNewFile,BufFilePost,BufWritePre * call <SID>ProtectSensitiveBuffer()
augroup END
